{
  "name": "sempre-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -f public/sw.js public/sw.js.map && next dev",
    "dev:clean": "rm -rf .next node_modules/.cache && rm -f public/sw.js public/sw.js.map && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run tests/unit",
    "test:watch": "vitest watch tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:ci": "vitest run tests/unit && vitest run tests/api",
    "dev:debug": "node scripts/dev-debugger/monitor.mjs",
    "debug:list": "node scripts/dev-debugger/cli.mjs list",
    "debug:unresolved": "node scripts/dev-debugger/cli.mjs unresolved",
    "debug:stats": "node scripts/dev-debugger/cli.mjs stats"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.44.0",
    "@serwist/next": "^9.0.0",
    "@slack/web-api": "^7.15.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "@tensorflow-models/speech-commands": "^0.5.4",
    "@tensorflow/tfjs": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.511.0",
    "next": "^15.0.0",
    "openai": "^6.18.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.7.0",
    "resend": "^6.9.4",
    "serwist": "^9.0.0",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.0.0",
    "pg": "^8.20.0",
    "puppeteer": "^24.38.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
