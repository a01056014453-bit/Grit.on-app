# ─────────────────────────────────────────────
# Supabase (필수)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사 금지
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─────────────────────────────────────────────
# 앱 URL
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://withsempre.com

# ─────────────────────────────────────────────
# 웹 푸시 (VAPID) — npx web-push generate-vapid-keys
# ─────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─────────────────────────────────────────────
# 소셜 로그인 (OAuth)
# ─────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
# Apple 로그인 — 둘 중 하나 (BASE64 우선)
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_BASE64=

# ─────────────────────────────────────────────
# AI (server-side only)
# ─────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
# Perplexity — 곡 분석 레퍼런스 검색용(강력 권장). 없으면 GPT만으로 분석되어 팩트 정확도 저하
PERPLEXITY_API_KEY=your_perplexity_api_key

# ─────────────────────────────────────────────
# OMR Server (optional — PDF → MusicXML 변환, Railway 배포 Audiveris)
# ─────────────────────────────────────────────
OMR_SERVER_URL=https://your-omr-server.up.railway.app

# ─────────────────────────────────────────────
# 크론/내부 API 보호 시크릿
# ─────────────────────────────────────────────
CRON_SECRET=
INTERNAL_CALL_SECRET=
CORE_API_KEY=

# ─────────────────────────────────────────────
# 관리자 (쉼표 구분 Supabase user ID)
# ─────────────────────────────────────────────
ADMIN_USER_IDS=your_admin_user_id

# ─────────────────────────────────────────────
# 모니터링 — Sentry (optional)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────
# Analytics (optional)
# ─────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=your_ga_id

# ─────────────────────────────────────────────
# 알림/연동 (optional)
# ─────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_GENERAL=
SLACK_AGENT_CHANNEL=
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER_NUMBER=
YOUTUBE_API_KEY=
GOOGLE_SHEETS_WEBHOOK_URL=

# ─────────────────────────────────────────────
# App Store Connect (admin 대시보드 다운로드 지표, optional)
# ─────────────────────────────────────────────
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_APP_ID=

# ─────────────────────────────────────────────
# CI/자동화 도구 전용 (로컬 개발에는 불필요)
# ─────────────────────────────────────────────
# GH_PAT= / GITHUB_TOKEN= / GITHUB_REPO= / VERCEL_TOKEN= / VERCEL_PROJECT_ID=

# ─────────────────────────────────────────────
# 개발 전용 — 프로덕션(Vercel production env)에 절대 설정 금지
# NEXT_PUBLIC_ 접두사라 클라이언트 번들에 노출됨
# ─────────────────────────────────────────────
# NEXT_PUBLIC_DEV_TEST_EMAIL=
# NEXT_PUBLIC_DEV_TEST_PASSWORD=
